{
  "name": "@tracker/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "migrate": "tsx --env-file-if-exists=../../.env src/cli.ts migrate",
    "status": "tsx --env-file-if-exists=../../.env src/cli.ts status",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "build:cli": "node ../../scripts/bundle.mjs src/cli.ts dist/cli.js"
  },
  "dependencies": {
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
