# =============================================================================
# Tracker — variáveis de ambiente (exemplo SEM valores reais).
# Copie para .env e preencha. Nunca faça commit de .env. Escopo:
#   [servidor] somente processos de servidor (API/worker). Nunca expor ao navegador.
#   [público]  pode aparecer no navegador (prefixo NEXT_PUBLIC_). Nunca coloque segredos aqui.
# Obrigatoriedade: (obrigatória) | (opcional) | (obrigatória em produção)
# =============================================================================

# ---- Ambiente ----------------------------------------------------------------
# [servidor] development | test | staging | production (obrigatória)
NODE_ENV=development
# [servidor] Identificador lógico do ambiente, gravado em entregas externas (obrigatória)
APP_ENV=local

# ---- URLs ---------------------------------------------------------------------
# [público] URL pública do painel web (obrigatória)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# [servidor] URL interna da API usada pelo servidor Next.js (obrigatória)
API_INTERNAL_URL=http://127.0.0.1:4000
# [servidor] URL pública da API (webhooks e coleta do SDK) — usada para montar URLs de webhook (obrigatória)
PUBLIC_API_URL=http://localhost:4000
# [servidor] Porta da API (opcional, padrão 4000)
API_PORT=4000
# [servidor] Origens permitidas para CORS do painel (lista separada por vírgula; CORS não é autenticação)
CORS_ORIGINS=http://localhost:3000

# ---- PostgreSQL ---------------------------------------------------------------
# Três conexões com papéis mínimos (ver docs/ARCHITECTURE.md#banco):
# [servidor] Migrações/setup — dono do schema. Formato postgres://usuario:senha@host:porta/banco (obrigatória p/ migrar)
DATABASE_URL_ADMIN=postgres://postgres:CHANGE_ME@127.0.0.1:5432/tracker_dev
# [servidor] API autenticada (papel tracker_app, sujeito a RLS) (obrigatória)
DATABASE_URL_APP=postgres://tracker_app:CHANGE_ME@127.0.0.1:5432/tracker_dev
# [servidor] Worker e ingestão pública (papel tracker_system, sujeito a RLS por organização) (obrigatória)
DATABASE_URL_SYSTEM=postgres://tracker_system:CHANGE_ME@127.0.0.1:5432/tracker_dev
# [servidor] Banco de testes de integração (opcional; padrão: mesmo host com banco tracker_test)
TEST_DATABASE_NAME=tracker_test
# [servidor] Senhas usadas apenas por scripts/db-setup.mjs em ambiente local (opcional)
DB_ADMIN_PASSWORD=
DB_APP_PASSWORD=
DB_SYSTEM_PASSWORD=
# [servidor] Supabase (alvo de implantação; opcional em desenvolvimento local — ver DECISIONS.md D-003)
SUPABASE_URL=
# [público] Chave pública (anon) do Supabase — somente se o painel usar Supabase diretamente (opcional)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Redis / worker -----------------------------------------------------------
# [servidor] Redis persistente para BullMQ (AOF habilitado) (obrigatória para worker)
REDIS_URL=redis://127.0.0.1:6379
# [servidor] Concorrência de jobs por processo do worker (opcional, padrão 8)
WORKER_CONCURRENCY=8
# [servidor] Intervalo do relay da outbox em ms (opcional, padrão 500)
OUTBOX_RELAY_INTERVAL_MS=500

# ---- Criptografia e assinatura ------------------------------------------------
# [servidor] Chaves de cifragem de credenciais (AES-256-GCM), base64 de 32 bytes, com versão.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotação: adicione nova versão, ajuste CREDENTIALS_KEY_CURRENT e mantenha a anterior até re-cifrar. (obrigatória)
CREDENTIALS_KEYS=1:CHANGE_ME_BASE64_32_BYTES
CREDENTIALS_KEY_CURRENT=1
# [servidor] Segredo para HMAC de tokens (sessão, convite, tokens de link), base64 >= 32 bytes (obrigatória)
TOKEN_HMAC_SECRET=CHANGE_ME_BASE64_32_BYTES
# [servidor] Nome do cookie de sessão e flag Secure (Secure obrigatório fora de localhost)
SESSION_COOKIE_NAME=trk_session
SESSION_COOKIE_SECURE=false
# [servidor] Duração da sessão em horas (opcional, padrão 336 = 14 dias)
SESSION_TTL_HOURS=336

# ---- E-mail transacional ------------------------------------------------------
# [servidor] Provedor: "log" (somente desenvolvimento: grava no log do servidor) ou "smtp" (opcional)
EMAIL_TRANSPORT=log
# [servidor] SMTP (obrigatória se EMAIL_TRANSPORT=smtp): smtps://usuário:senha@host:465 ou smtp://…:587 (STARTTLS).
# Em APP_ENV=production o envio sem TLS é recusado; "log" e "file" também são recusados em produção. Obtenha no painel do seu provedor.
SMTP_URL=
EMAIL_FROM="Tracker <no-reply@example.com>"

# ---- OAuth / provedores -------------------------------------------------------
# [servidor] Meta Ads: a conexão usa um token de usuário do sistema colado no painel (Integrações → Meta), guardado
# cifrado no banco — não coloque tokens aqui. META_APP_SECRET é opcional: quando definido, as chamadas levam
# appsecret_proof (recomendado se o app exigir "Require App Secret"). Obtenha em developers.facebook.com → app → Configurações → Básico.
META_APP_SECRET=
# [servidor] Versão da Graph API (verificada nos SDKs oficiais: facebook_business 26.0.2 → v26.0)
META_GRAPH_API_VERSION=v26.0
# [servidor] Google OAuth (login e Google Ads; ver DEP-GOOGLE-APP) (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/v1/oauth/google/callback
# [servidor] TikTok (ver DEP-TIKTOK-APP) (opcional)
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# ---- Cobrança da plataforma (SaaS) ---------------------------------------------
# [servidor] Provedor de cobrança da plataforma (ex.: stripe) — sandbox até decisão comercial (opcional)
BILLING_PROVIDER=none
BILLING_SECRET_KEY=
BILLING_WEBHOOK_SECRET=

# ---- IA -----------------------------------------------------------------------
# [servidor/worker] Provedor de IA do Gestor IA: anthropic (adaptador implementado) | openai | google (planejados) | none.
# Sem provedor e chave, o Gestor IA aparece como indisponível. Cada organização ainda precisa ligá-lo (proprietário)
# e pode cadastrar chave própria no painel (cofre cifrado, prioridade sobre esta). (opcional)
AI_PROVIDER=none
# [servidor/worker] Chave do provedor (nunca vai ao navegador nem a commits)
AI_API_KEY=
# [servidor/worker] Modelo (vazio = claude-opus-5-5 na Anthropic). Use "Testar chave e modelo" no painel para conferir.
AI_MODEL=
# [servidor/worker] Esforço de raciocínio: low | medium | high | xhigh | max | none (padrão medium)
AI_EFFORT=medium
# [servidor/worker] Recuperação automática do provedor quando o modelo recusa (fallbacks "default"): default | off
AI_FALLBACKS=default

# ---- Observabilidade ----------------------------------------------------------
# [servidor] Nível de log (debug|info|warn|error) (opcional)
LOG_LEVEL=info
# [servidor] DSN de rastreamento de erros (opcional)
ERROR_TRACKING_DSN=

# ---- Feature flags --------------------------------------------------------------
# [servidor] Lista separada por vírgula de flags globais habilitadas (opcional)
FEATURE_FLAGS=
# [servidor] Permite envio real a destinos externos neste ambiente (padrão false; exige também destino habilitado)
ALLOW_EXTERNAL_DELIVERY=false

# ---------------------------------------------------------------- API pública e webhooks de saída
# [servidor] Limite de requisições por minuto por chave de API e por organização (compartilhado entre instâncias via banco)
API_RATE_LIMIT_PER_KEY=120
API_RATE_LIMIT_PER_ORG=600
# [servidor] Limites de ingestão por instância da API (por minuto): webhooks por endpoint e coleta do SDK por IP.
# Ajuste para picos (lançamentos) com base no teste de carga; provedores que reenviam após 429 não perdem vendas.
WEBHOOK_RATE_LIMIT_PER_MINUTE=600
COLLECT_RATE_LIMIT_PER_MINUTE=300
# [servidor/worker] SOMENTE desenvolvimento/testes: permite webhooks de saída para redes privadas/loopback (recusado em produção)
OUTBOUND_ALLOW_PRIVATE_NETWORKS=false
# [servidor/worker] Exige https nos destinos de webhooks de saída (sempre exigido em produção)
OUTBOUND_REQUIRE_HTTPS=false
# [servidor/worker] Hosts adicionais proibidos como destino (além de PUBLIC_API_URL e NEXT_PUBLIC_APP_URL), separados por vírgula
OUTBOUND_BLOCKED_HOSTS=
# [servidor/worker] Tempo máximo por entrega de webhook de saída (ms)
OUTBOUND_TIMEOUT_MS=10000

# ---- Notificações (R34) -------------------------------------------------------
# [servidor/worker] Web Push (VAPID). Gere com: pnpm push:keys — a chave PRIVADA nunca vai ao navegador nem a commits.
# Sem as três variáveis, o push aparece como "não configurado" no painel (painel e e-mail continuam funcionando).
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# [servidor/worker] Contato do operador exigido pelos serviços de push: mailto:... ou https://...
WEB_PUSH_SUBJECT=
# [servidor/worker] Hosts de serviços de push aceitos (sufixos, vírgula). Padrão: FCM, Mozilla, Apple e Windows.
WEB_PUSH_ALLOWED_HOSTS=
# [worker] Intervalo do agendador de monitores (ms; padrão 60000). Os ciclos por organização são de 5 min.
SCHEDULER_INTERVAL_MS=60000
# [worker] Parada de emergência de TODAS as regras (nenhuma ação executada; simulações continuam). Padrão false.
RULES_KILL_SWITCH=false
