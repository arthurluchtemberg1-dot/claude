# Variáveis da implantação de referência (deploy/docker-compose.yml). Copie para deploy/.env (não versionado).
# Gere segredos com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# URLs públicas (HTTPS no proxy reverso). PUBLIC_API_URL recebe webhooks e a API pública.
PUBLIC_API_URL=https://api.seu-dominio.com.br
NEXT_PUBLIC_APP_URL=https://app.seu-dominio.com.br
APP_ENV=production

# Banco: senha do superusuário (só migrações/papéis) e dos papéis mínimos (>= 16 caracteres, distintas).
POSTGRES_PASSWORD=CHANGE_ME
DB_APP_PASSWORD=CHANGE_ME_MIN_16_CHARS
DB_SYSTEM_PASSWORD=CHANGE_ME_MIN_16_CHARS

# Cofre de credenciais (versão:base64 de 32 bytes) e HMAC de tokens. Guarde FORA do servidor de banco e dos backups.
CREDENTIALS_KEYS=1:CHANGE_ME_BASE64_32_BYTES
CREDENTIALS_KEY_CURRENT=1
TOKEN_HMAC_SECRET=CHANGE_ME_BASE64_32_BYTES

# Sessão e segurança
SESSION_COOKIE_SECURE=true
MFA_REQUIRED_DEFAULT=true

# E-mail transacional (log apenas em homologação; em produção use smtp com as variáveis do .env.example raiz)
EMAIL_TRANSPORT=log
EMAIL_FROM=Tracker <no-reply@seu-dominio.com.br>

# Envio real a destinos e webhooks de saída (false até validar cada integração)
ALLOW_EXTERNAL_DELIVERY=false

# Portas publicadas no host (atrás do proxy reverso)
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1
