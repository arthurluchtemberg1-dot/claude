# Variáveis da implantação de referência (deploy/docker-compose.yml). Copie para deploy/.env (não versionado).
# Gere segredos com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Gerado automaticamente por deploy/install.sh (recomendado). Para preencher à mão:
# Domínio servido pelo Caddy (perfil "https") e e-mail para o certificado.
TRACKER_DOMAIN=painel.seu-dominio.com.br
ACME_EMAIL=voce@seu-dominio.com.br

# URLs públicas. Com o Caddy do perfil "https", a API fica em https://DOMINIO/api.
PUBLIC_API_URL=https://painel.seu-dominio.com.br/api
NEXT_PUBLIC_APP_URL=https://painel.seu-dominio.com.br
APP_ENV=production

# Banco: senha do superusuário (só migrações/papéis) e dos papéis mínimos (>= 16 caracteres, distintas).
POSTGRES_PASSWORD=CHANGE_ME
DB_APP_PASSWORD=CHANGE_ME_MIN_16_CHARS
DB_SYSTEM_PASSWORD=CHANGE_ME_MIN_16_CHARS

# Cofre de credenciais (versão:base64 de 32 bytes) e HMAC de tokens. Guarde FORA do servidor de banco e dos backups.
CREDENTIALS_KEYS=1:CHANGE_ME_BASE64_32_BYTES
CREDENTIALS_KEY_CURRENT=1
TOKEN_HMAC_SECRET=CHANGE_ME_BASE64_32_BYTES

# Sessão e segurança
SESSION_COOKIE_SECURE=true
MFA_REQUIRED_DEFAULT=true

# Cadastro público: "closed" em instalação privada (proprietário criado com: docker compose ... exec api node dist/admin.js create-owner --email ...)
SIGNUP_MODE=closed

# E-mail transacional: "disabled" (sem e-mails; senha/MFA redefinidos pelo admin.js) ou "smtp" com SMTP_URL (smtps://usuario:senha@host:465).
# "log" é recusado em produção.
EMAIL_TRANSPORT=disabled
SMTP_URL=
EMAIL_FROM=Tracker <no-reply@seu-dominio.com.br>

# Envio real: notificações push, ações na Meta (ainda travadas pelo proprietário no painel), API de Conversões e webhooks.
ALLOW_EXTERNAL_DELIVERY=false

# Meta Ads: o token é colado no painel (Integrações → Meta). Opcional: segredo do app para appsecret_proof.
META_GRAPH_API_VERSION=v26.0
META_APP_SECRET=

# Portas publicadas no host (atrás do proxy reverso)
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1

# Notificações: Web Push (gere com `pnpm push:keys`; guarde a privada no cofre do provedor) e contato do operador.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:operacao@seu-dominio.com.br
