{
  "name": "@tracker/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "build": "node ../../scripts/bundle.mjs src/server.ts dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "simulate:webhook": "tsx --env-file-if-exists=../../.env src/cli/simulate-webhook.ts",
    "diag": "tsx --env-file-if-exists=../../.env src/cli/diag.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@tracker/connectors": "workspace:*",
    "@tracker/contracts": "workspace:*",
    "@tracker/db": "workspace:*",
    "@tracker/domain": "workspace:*",
    "fastify": "5.12.5",
    "ioredis": "5.11.1",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tracker/worker": "workspace:*",
    "@types/node": "22.20.4",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/smtp-server": "3.5.13",
    "bullmq": "6.3.8",
    "esbuild": "0.28.2",
    "smtp-server": "3.19.13",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
