{
  "name": "@tracker/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "build": "node ../../scripts/bundle.mjs src/main.ts dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "seed:demo": "tsx --env-file-if-exists=../../.env src/cli/seed-demo.ts"
  },
  "dependencies": {
    "@tracker/connectors": "workspace:*",
    "@tracker/db": "workspace:*",
    "@tracker/domain": "workspace:*",
    "bullmq": "6.3.8",
    "ioredis": "5.11.1",
    "pg": "8.23.0",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
